<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="IssuePilot transforma relatos de bugs em ações claras." />
  <title>IssuePilot — clareza para cada issue</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
  <header class="site-header"><div class="shell header-inner"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">IP</span> IssuePilot</a><span class="header-note">Análise assistida · decisão humana</span></div></header>
  <main id="main-content" class="shell">@RenderBody()</main>
  <footer class="shell footer">IssuePilot · Issues públicas e rascunhos · Nenhuma alteração é feita no GitHub. <a asp-controller="Home" asp-action="Privacy">Privacidade</a></footer>
</body>
</html>
